# Copy to .env.local and fill in. Values are NOT committed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# OPTIONAL. Locks the content MCP server at POST /api/mcp behind HTTP Basic
# auth, which lets an AI assistant read and edit site content.
#
# Set BOTH to require a username and password. Leave either blank and the
# endpoint is OPEN to anyone who can reach it - fine on localhost, but on a
# public domain it means strangers can rewrite your site's text and images.
#
# Even when open, the endpoint cannot delete content, run SQL, or read the
# contact inbox. Those limits are in the code, not in these variables.
MCP_USERNAME=
MCP_PASSWORD=
